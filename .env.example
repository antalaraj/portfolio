# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE - RAJ ANTALA PORTFOLIO & CUSTOM CMS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com
DJANGO_SETTINGS_MODULE=config.settings.development

# CORS Configuration (Frontend URLs allowed to connect)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (NEON POSTGRESQL)
# ------------------------------------------------------------------------------
# In local development, SQLite fallback can be used if DB_URL is omitted.
# In production, provide the Neon PostgreSQL connection string:
DATABASE_URL=postgresql://neondb_owner:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. CLOUDINARY MEDIA STORAGE
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 4. SUPERADMIN INITIAL CREDENTIALS (USED BY SEED SCRIPT)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@rajantala.com
ADMIN_USERNAME=rajantala
ADMIN_PASSWORD=SetSecurePasswordHere123!

# ------------------------------------------------------------------------------
# 5. FRONTEND (NEXT.JS) CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
REVALIDATION_SECRET_TOKEN=generate-a-strong-secret-token-for-isr-cache-purge

# ------------------------------------------------------------------------------
# 6. FUTURE AI ASSISTANT CONFIGURATION (PHASE 9)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# or OPENAI_API_KEY=your_openai_api_key_here
